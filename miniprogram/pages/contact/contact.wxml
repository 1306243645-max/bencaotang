<view class="header">
  <text class="header-title">📞 联系我们</text>
</view>
<view class="card">
  <view class="contact-item" bindtap="callPhone">
    <view class="contact-icon">📞</view>
    <view>电话：{{phone}}</view>
  </view>
  <view class="contact-item" bindtap="copyWechat">
    <view class="contact-icon">💬</view>
    <view>微信：{{wechat}}（点击复制）</view>
  </view>
  <view class="contact-item">
    <view class="contact-icon">📧</view>
    <view>邮箱：{{email}}</view>
  </view>
  <view class="contact-item">
    <view class="contact-icon">📍</view>
    <view>地址：{{address}}</view>
  </view>
  <view class="contact-item">
    <view class="contact-icon">🕐</view>
    <view>应诊时间：周一至周五 8:30-17:30，周六 9:00-16:00</view>
  </view>
</view>
<button class="btn-primary" bindtap="callPhone">📞 拨打电话</button>
<button class="btn-primary" style="background:#52b788" bindtap="goConsult">💬 AI 在线问诊</button>
