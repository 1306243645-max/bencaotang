<!-- ═══════════ AI问诊 ═══════════ -->

<!-- 聊天消息区 -->
<scroll-view class="chat-area" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation
  style="height: {{showTemplates ? 'calc(100vh - 520rpx)' : 'calc(100vh - 120rpx)'}};">

  <!-- 空状态 / 欢迎页 -->
  <view wx:if="{{messages.length === 0 && showTemplates}}" style="padding: 40rpx 24rpx;">
    <view style="text-align: center; margin-bottom: 32rpx;">
      <view style="font-size: 80rpx; margin-bottom: 16rpx;">🌿</view>
      <view style="font-size: 34rpx; font-weight: 700; color: #2D3436;">本草堂 AI 健康顾问</view>
      <view style="font-size: 26rpx; color: #999; margin-top: 8rpx;">描述症状，即刻辨证分析</view>
      <view style="font-size: 22rpx; color: #C0C0C0; margin-top: 8rpx;">⚠️ AI提供健康教育信息，不替代医生诊断</view>
    </view>

    <!-- 模板分类Tab -->
    <scroll-view scroll-x class="cat-tabs" style="margin: 0 -24rpx;">
      <view wx:for="{{templates}}" wx:key="category"
        class="cat-tab {{index === activeTemplateCat ? 'active' : ''}}"
        data-idx="{{index}}" bindtap="switchTemplateCat">
        {{item.icon}} {{item.category}}
      </view>
    </scroll-view>

    <!-- 当前分类的模板按钮 -->
    <view style="display: flex; flex-wrap: wrap; padding: 20rpx 0;" wx:if="{{templates.length > 0}}">
      <view wx:for="{{templates[activeTemplateCat].items}}" wx:key="label" wx:for-item="tpl"
        class="template-btn" bindtap="tapTemplate" data-prompt="{{tpl.prompt}}"
        style="margin-bottom: 16rpx;">
        {{tpl.label}}
      </view>
    </view>
  </view>

  <!-- 聊天消息列表 -->
  <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
    <view class="msg-row {{item.role === 'user' ? 'user' : 'ai'}}">
      <!-- AI头像 -->
      <view wx:if="{{item.role === 'ai'}}" style="font-size: 40rpx; margin-right: 12rpx; flex-shrink: 0;">🌿</view>

      <view>
        <!-- 消息气泡 -->
        <view class="msg-bubble {{item.role}}">
          <!-- 舌象图片 -->
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill"
            style="width: 200rpx; height: 200rpx; border-radius: 12rpx; margin-bottom: 12rpx;" />
          <text>{{item.content}}</text>
        </view>
        <!-- 时间 -->
        <view style="font-size: 20rpx; color: #C0C0C0; margin-top: 6rpx; {{item.role === 'user' ? 'text-align: right;' : 'text-align: left;'}} padding: 0 8rpx;">
          {{item.time}}
        </view>
      </view>

      <!-- 用户头像 -->
      <view wx:if="{{item.role === 'user'}}" style="font-size: 40rpx; margin-left: 12rpx; flex-shrink: 0;">🧑</view>
    </view>
  </view>

  <!-- 正在输入指示 -->
  <view wx:if="{{isSending}}" class="msg-row ai">
    <view style="font-size: 40rpx; margin-right: 12rpx;">🌿</view>
    <view class="msg-bubble ai" style="color: #999;">
      <text>辨证分析中</text>
      <text style="animation: blink 1s infinite;">...</text>
    </view>
  </view>
</scroll-view>

<!-- 舌诊上传面板 -->
<view wx:if="{{showTonguePanel}}" class="overlay" bindtap="toggleTonguePanel">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">📸 上传舌象照片</view>
    <view style="font-size: 24rpx; color: #999; text-align: center; margin-bottom: 24rpx;">
      自然光 · 不美颜 · 舌头自然伸出
    </view>
    <view style="display: flex; gap: 24rpx;">
      <view style="flex: 1; text-align: center; background: #F5F7FA; border-radius: 16rpx; padding: 32rpx;"
        bindtap="takeTonguePhoto">
        <view style="font-size: 56rpx;">📷</view>
        <view style="font-size: 28rpx; color: #2D3436; margin-top: 8rpx;">拍照</view>
      </view>
      <view style="flex: 1; text-align: center; background: #F5F7FA; border-radius: 16rpx; padding: 32rpx;"
        bindtap="chooseTonguePhoto">
        <view style="font-size: 56rpx;">🖼️</view>
        <view style="font-size: 28rpx; color: #2D3436; margin-top: 8rpx;">相册选择</view>
      </view>
    </view>
    <view style="text-align: center; margin-top: 24rpx; font-size: 26rpx; color: #2B7A4B;"
      bindtap="toggleTonguePanel">
      取消
    </view>
  </view>
</view>

<!-- 底部操作栏 -->
<view wx:if="{{!showTonguePanel}}">
  <!-- 快捷操作 -->
  <view wx:if="{{messages.length > 0}}" style="display: flex; align-items: center; padding: 8rpx 24rpx;">
    <view style="font-size: 36rpx; padding: 8rpx 16rpx;" bindtap="toggleTonguePanel">📷</view>
    <view style="font-size: 34rpx; padding: 8rpx 16rpx;" bindtap="newChat">🔄</view>
  </view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <view style="font-size: 36rpx; padding-right: 8rpx;" bindtap="toggleTonguePanel">📷</view>
    <input class="input" value="{{inputValue}}" placeholder="描述你的症状..."
      bindinput="onInput" bindconfirm="sendMessage" confirm-type="send"
      focus="{{false}}" adjust-position="{{true}}" />
    <view class="btn-send" bindtap="sendMessage">
      <text>↑</text>
    </view>
  </view>
</view>
